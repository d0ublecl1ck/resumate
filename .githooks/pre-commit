#!/usr/bin/env bash
# pre-commit: 删除不再为空的目录中的 .gitkeep
# 判定标准：.gitkeep 被 Git 跟踪，且其目录（含子目录）下存在其他被跟踪的文件。
# 仅有未跟踪文件（如 .DS_Store）时保留 .gitkeep。
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

removed=()
while IFS= read -r gk; do
  dir=${gk%/.gitkeep}
  others=$(git ls-files -- "$dir" | grep -vxF "$gk" | head -n 1 || true)
  if [ -n "$others" ]; then
    git rm -q --cached -- "$gk"
    rm -f -- "$gk"
    removed+=("$gk")
  fi
done < <(git ls-files '*.gitkeep')

if ((${#removed[@]})); then
  echo "pre-commit: 已删除不再为空的目录中的 .gitkeep:"
  printf '  %s\n' "${removed[@]}"
fi

# >>> quality-gates >>>
# 项目门禁：与 `archkit inspect .` 同源地执行 quality-gates/gates/*.js。
# 失败即拦截本次提交；确实需要紧急提交时用 git commit --no-verify，并在提交说明或汇报里写清原因。
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: 找不到 node，无法运行项目门禁；装好 node 再提交，或用 --no-verify 显式跳过。" >&2
  exit 1
fi
if ! node "$(git rev-parse --show-toplevel)/quality-gates/run.js"; then
  echo "pre-commit: 项目门禁未通过，已拦截本次提交（修完再提交；确需绕过用 --no-verify）。" >&2
  exit 1
fi
# <<< quality-gates <<<
