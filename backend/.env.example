# Local development database (PostgreSQL + psycopg 3).
DATABASE_URL=postgresql+psycopg://localhost:5432/resumate
# Isolated database used by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/resumate_test
# Derives the Fernet key that encrypts stored model API keys.
# Override in every non-local deployment; rotating it makes existing ciphertext unreadable.
SETTINGS_SECRET_KEY=resumate-local-dev-secret

# Redis session store (opaque tokens are validated against it on every request).
REDIS_URL=redis://localhost:6379/0

# Session cookie. Set SESSION_COOKIE_SECURE=true behind HTTPS in production.
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=resumate_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Bootstrap admin created by app.tasks.seed; change the password before deploying.
BOOTSTRAP_ADMIN_EMAIL=admin@resumate.dev
BOOTSTRAP_ADMIN_PASSWORD=resumate-admin
BOOTSTRAP_ADMIN_NAME=管理员

# Email verification: registration mails a link instead of granting a session.
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=1800
# A consumed or expired token can still request a resend for this long.
EMAIL_VERIFICATION_LOOKUP_TTL_SECONDS=604800
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5

# Password reset by emailed one-time link; mirrors the verification knobs.
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
PASSWORD_RESET_LOOKUP_TTL_SECONDS=604800
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5

# SMTP relay for verification and password reset mail.
# 启动自检会校验这一组配置：SMTP_HOST 为空时默认拒绝启动（设 RESUMATE_ALLOW_MISSING_ENV=1 可
# 降级为醒目 WARNING）；配置了 SMTP_HOST 却缺 SMTP_FROM_EMAIL，或认证凭据只配一半，一律启动失败。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
# Base URL used to build the verification and password reset links that go into the mail.
PUBLIC_WEB_BASE_URL=http://localhost:5173

# git worktree 不会带过来未跟踪的 .env，需要手动复制：在新 worktree 的 backend/ 下执行
# cp .env.example .env（或从主工作区复制 backend/.env），再补齐真实取值，否则启动自检会失败。
