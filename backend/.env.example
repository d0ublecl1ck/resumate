# Local development database (PostgreSQL + psycopg 3).
DATABASE_URL=postgresql+psycopg://localhost:5432/resumate
# Isolated database used by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/resumate_test
# Derives the Fernet key that encrypts stored model API keys.
# Override in every non-local deployment; rotating it makes existing ciphertext unreadable.
SETTINGS_SECRET_KEY=resumate-local-dev-secret
