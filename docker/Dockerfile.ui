# 前端镜像：多阶段构建，nginx 托管 ui/dist 并反代 /api 到 backend。
FROM node:24-alpine AS build

# pnpm 在非 TTY 环境会以 ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY 直接失败，
# 必须显式声明 CI 环境。
ENV CI=true
# 依赖源可覆盖：--build-arg NPM_REGISTRY=https://registry.npmjs.org
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm config set registry "${NPM_REGISTRY}" && npm install -g pnpm@10.34.5

WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY ui/package.json ui/
RUN pnpm install --frozen-lockfile

COPY ui/ ui/
RUN pnpm -C ui build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/ui/dist /usr/share/nginx/html
EXPOSE 80
